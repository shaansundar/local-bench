# Copy to .env (gitignored). Only set what you use.

# opencode Zen / Go (Muse Spark 1.3 Free and other opencode-only models). Passed through to every
# `opencode run` the suite starts; get it from https://opencode.ai (or run `opencode auth login`).
OPENCODE_API_KEY=

# Cloud judge / reference models (referenced from models.yaml as env:VAR)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Gated Hugging Face datasets (or run `hf auth login`)
HF_TOKEN=

# sec.gov refuses downloads without a declared contact; OfficeComprehensionBench fetches SEC filings.
# Format: "Your Name your@email.com"
BENCH_DOWNLOAD_USER_AGENT=

# Temporarily override config.yaml judge.model (e.g. a local stand-in for smoke tests)
BENCH_JUDGE_MODEL=

# Use a different model registry or results store (defaults: ./models.yaml, else
# ./models.example.yaml; ./results). Handy for separate setups or the demo data in scripts/.
BENCH_MODELS=
BENCH_RESULTS_DIR=
